;;; kittymacs-org-tasks-tests.el --- Test project task dependencies -*- lexical-binding: t; -*-
(require 'ert)
(require 'package)
(when-let* ((directory (getenv "KITTYMACS_TEST_PACKAGES")))
  (setq package-user-dir directory))
(setq kittymacs-profile 'minimal)
(package-initialize)
(add-to-list 'load-path (expand-file-name "../lisp" (file-name-directory load-file-name)))
(require 'use-package)
(require 'kittymacs-features)
(require 'org)
(require 'org-id)
(require 'org-edna)
(let ((use-package-ensure-function #'ignore))
  (require 'kittymacs-org-tasks))

(defmacro kittymacs-org-tasks-test (&rest body)
  "Create two file-backed tasks A and B and evaluate BODY."
  (declare (indent 0))
  `(let* ((root (make-temp-file "kittymacs-task-test-" t))
          (org-id-locations-file (expand-file-name "ids" root))
          (org-id-locations (make-hash-table :test #'equal))
          (org-id-files nil)
          (org-agenda-files nil)
          (org-todo-keywords '((sequence "TODO" "NEXT" "|" "DONE")))
          (org-log-done nil)
          (org-treat-insert-todo-heading-as-state-change nil)
          buffers)
     (unwind-protect
         (let ((a (kittymacs-org-tasks-test--task "a" root))
               (b (kittymacs-org-tasks-test--task "b" root)))
           (setq buffers (list (marker-buffer a) (marker-buffer b)))
           (org-edna-reset-cache)
           ,@body)
       (dolist (buffer buffers)
         (with-current-buffer buffer (set-buffer-modified-p nil))
         (kill-buffer buffer))
       (delete-directory root t))))

(defun kittymacs-org-tasks-test--task (name root)
  "Return marker to a task NAME in a new file under ROOT."
  (let ((file (expand-file-name (concat name ".org") root)))
    (with-temp-file file (insert (format "* TODO Task %s\n" name)))
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-min))
      (point-marker))))

(ert-deftest kittymacs-org-tasks-blocks-and-reflects-cross-file-changes ()
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--relate b a nil)
    (should (equal "Blocked" (kittymacs-org-tasks--at b #'kittymacs-org-tasks--status)))
    (kittymacs-org-tasks--at b (lambda () (ignore-errors (org-todo "DONE"))))
    (should (equal "TODO" (kittymacs-org-tasks--at b #'org-get-todo-state)))
    (kittymacs-org-tasks--at a (lambda () (org-todo "DONE")))
    (should-not (kittymacs-org-tasks--at b #'kittymacs-org-tasks--status))
    (kittymacs-org-tasks--at b (lambda () (org-todo "DONE")))
    (should (equal "DONE" (kittymacs-org-tasks--at b #'org-get-todo-state)))))

(ert-deftest kittymacs-org-tasks-preserves-rules-and-refuses-cycles ()
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--at b (lambda () (org-entry-put nil "BLOCKER" "self done?")))
    (kittymacs-org-tasks--relate b a nil)
    (let ((rule (kittymacs-org-tasks--at b (lambda () (org-entry-get nil "BLOCKER")))))
      (should (string-prefix-p "self done?  ids(" rule))
      (kittymacs-org-tasks--relate b a nil)
      (should (equal rule (kittymacs-org-tasks--at b (lambda () (org-entry-get nil "BLOCKER"))))))
    (should-error (kittymacs-org-tasks--relate a b nil) :type 'user-error)))

(ert-deftest kittymacs-org-tasks-checks-every-prerequisite ()
  (kittymacs-org-tasks-test
    (let ((c (kittymacs-org-tasks-test--task "c" root)))
      (push (marker-buffer c) buffers)
      (kittymacs-org-tasks--relate c a nil)
      (kittymacs-org-tasks--relate c b nil)
      (kittymacs-org-tasks--at a (lambda () (org-todo "DONE")))
      (should (equal "Blocked" (kittymacs-org-tasks--at c #'kittymacs-org-tasks--status)))
      (kittymacs-org-tasks--at b (lambda () (org-todo "DONE")))
      (should-not (kittymacs-org-tasks--at c #'kittymacs-org-tasks--status)))))

(ert-deftest kittymacs-org-tasks-explicit-trigger-updates-dependent ()
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--relate b a "NEXT")
    (kittymacs-org-tasks--at a (lambda () (org-todo "DONE")))
    (should (equal "NEXT" (kittymacs-org-tasks--at b #'org-get-todo-state)))))

(ert-deftest kittymacs-org-tasks-reports-unresolved-blocker ()
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--at a (lambda () (org-entry-put nil "BLOCKER" "ids(\"missing\")")))
    (should (equal "Missing: missing" (kittymacs-org-tasks--at a #'kittymacs-org-tasks--status)))))

(ert-deftest kittymacs-org-tasks-view-filters-using-current-dependencies ()
  (require 'org-ql)
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--relate b a nil)
    (with-temp-buffer
      (setq-local kittymacs-org-tasks--view-files
                  (list (buffer-file-name (marker-buffer a)) (buffer-file-name (marker-buffer b)))
                  kittymacs-org-tasks--view-blocked t)
      (should (equal (list b) (mapcar #'car (kittymacs-org-tasks--rows))))
      (kittymacs-org-tasks--at a (lambda () (org-todo "DONE")))
      (should-not (kittymacs-org-tasks--rows)))))

(ert-deftest kittymacs-org-tasks-kanban-move-refreshes-a-refused-transition ()
  (skip-unless (require 'org-kanban nil t))
  (kittymacs-org-tasks-test
    (kittymacs-org-tasks--relate b a nil)
    (with-current-buffer (marker-buffer b)
      (goto-char (point-max))
      (insert "\n#+BEGIN: kanban\n#+END:\n")
      (forward-line -2)
      (org-update-dblock)
      (goto-char (point-min))
      (re-search-forward "^|.*Task b")
      (let ((direction (if (save-excursion
                             (beginning-of-line)
                             (looking-at-p "|[[:space:]]*\\[\\["))
                           'right 'left)))
        (kittymacs-org-tasks-board-move direction)
        (should (equal "NEXT" (kittymacs-org-tasks--at b #'org-get-todo-state)))
        (goto-char (point-min))
        (re-search-forward "^|.*Task b")
        (let ((before (buffer-string)))
          (kittymacs-org-tasks-board-move direction)
          (should (equal before (buffer-string)))
          (should (equal "NEXT" (kittymacs-org-tasks--at b #'org-get-todo-state))))
        (kittymacs-org-tasks--at a (lambda () (org-todo "DONE")))
        (goto-char (point-min))
        (re-search-forward "^|.*Task b")
        (let ((org-log-done 'time))
          (kittymacs-org-tasks-board-move direction))
        (should (equal "DONE" (kittymacs-org-tasks--at b #'org-get-todo-state)))
        (should (kittymacs-org-tasks--at b (lambda () (org-entry-get nil "CLOSED"))))))))
