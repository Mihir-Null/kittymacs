;;; kittymacs-agents-tests.el --- ACP host settings -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(add-to-list 'load-path (expand-file-name "../lisp" (file-name-directory load-file-name)))
(require 'kittymacs-features)
(defvar agent-shell-preferred-agent-config nil)
(let ((kittymacs-profile 'minimal) (kittymacs-features nil))
  (require 'kittymacs-agents))

(ert-deftest kittymacs-agents-offers-the-picker-by-default ()
  (should-not (default-value 'kittymacs-agent-harness)))

(ert-deftest kittymacs-agents-harnesses-are-complete-and-sorted ()
  ;; Snapshot of every configuration identifier in the pinned upstream registry.
  (should (equal (sort (mapcar #'car kittymacs-agent-harnesses) #'string<)
                 '(antigravity auggie claude-code cline codebuddy codex copilot cursor
                   deepseek droid gemini-cli goose grok-build hermes junie kimi kiro
                   mistral-vibe omp openclaw opencode pi qoder qwen-code)))
  (let ((labels (mapcar (lambda (row) (plist-get (cdr row) :label))
                        kittymacs-agent-harnesses)))
    (should (equal labels (sort (copy-sequence labels)
                               (lambda (a b) (string< (downcase a) (downcase b))))))))

(ert-deftest kittymacs-agents-preserves-explicit-environments-and-unlisted-commands ()
  (let* ((kittymacs-agent-harnesses
          '((codex :command-option kittymacs-agents-test-command
                   :environment-option kittymacs-agents-test-environment)))
         (kittymacs-agent-commands nil))
    (cl-progv '(kittymacs-agents-test-command kittymacs-agents-test-environment)
        '(("original") ("TOKEN=explicit"))
      (cl-letf (((symbol-function 'agent-shell-make-environment-variables)
                 (lambda (&rest _) (ert-fail "Replaced an explicit environment"))))
        (kittymacs-agent-configure-harnesses)
        (should (equal (symbol-value 'kittymacs-agents-test-command) '("original")))
        (should (equal (symbol-value 'kittymacs-agents-test-environment)
                       '("TOKEN=explicit")))))))

(ert-deftest kittymacs-agents-applies-wrappers-and-inherits-unset-environments ()
  (let* ((kittymacs-agent-harnesses
          '((claude-code :command-option kittymacs-agents-test-command
                         :environment-option kittymacs-agents-test-environment)))
         (kittymacs-agent-commands '((claude-code . ("wrapper" "--acp")))))
    (cl-progv '(kittymacs-agents-test-command kittymacs-agents-test-environment)
        '(("legacy-claude-command") nil)
      (cl-letf (((symbol-function 'agent-shell-make-environment-variables)
                 (lambda (&rest args)
                   (should (equal args '(:inherit-env t)))
                   '("PATH=/test"))))
        (kittymacs-agent-configure-harnesses)
        (should (equal (symbol-value 'kittymacs-agents-test-command)
                       '("wrapper" "--acp")))
        (should (equal (symbol-value 'kittymacs-agents-test-environment)
                       '("PATH=/test")))))))

(ert-deftest kittymacs-agents-rejects-malformed-command-overrides ()
  (let ((kittymacs-agent-harnesses '((codex :command-option unused)))
        (kittymacs-agent-commands '((codex . "a shell string"))))
    (should-error (kittymacs-agent-configure-harnesses))))

(ert-deftest kittymacs-agents-can-pick-another-harness-without-changing-the-default ()
  (let ((agent-shell-preferred-agent-config 'codex) called)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest _)
                 (should (eq feature 'agent-shell)) t))
              ((symbol-function 'agent-shell-new-shell)
               (lambda ()
                 (should-not agent-shell-preferred-agent-config)
                 (setq called t))))
      (kittymacs-agent-choose-harness))
    (should called)
    (should (eq agent-shell-preferred-agent-config 'codex))))

(defmacro kittymacs-agents-test-with-interfaces (enabled &rest body)
  "Run BODY with ENABLED interfaces available, without loading their packages."
  (declare (indent 1))
  `(let ((kittymacs-features nil)
         (kittymacs-agent-primary-interface nil))
     (cl-letf (((symbol-function 'kittymacs-feature-p)
                (lambda (feature) (memq feature ,enabled)))
               ((symbol-function 'locate-library) (lambda (&rest _) "test-package")))
       ,@body)))

(ert-deftest kittymacs-agents-primary-preserves-legacy-preferences-and-explicit-choice ()
  (kittymacs-agents-test-with-interfaces '(agents agent-gptel claude-code-ide)
    (should (eq (kittymacs-agent--primary) 'agent-shell))
    (let ((kittymacs-features '(agent-gptel)))
      (should (eq (kittymacs-agent--primary) 'gptel-agent)))
    (let ((kittymacs-agent-primary-interface 'claude-code-ide))
      (should (eq (kittymacs-agent--primary) 'claude-code-ide))))
  (kittymacs-agents-test-with-interfaces '(agents agent-gptel claude-code-ide agent-claude-code-ide)
    (should (eq (kittymacs-agent--primary) 'claude-code-ide))
    (let ((kittymacs-agent-primary-interface 'gptel-agent))
      (should (eq (kittymacs-agent--primary) 'gptel-agent)))))

(ert-deftest kittymacs-agents-primary-falls-back-without-enabling-an-interface ()
  (kittymacs-agents-test-with-interfaces '(agent-gptel)
    (let ((kittymacs-agent-primary-interface 'agent-shell))
      (should (eq (kittymacs-agent--primary) 'gptel-agent))))
  (kittymacs-agents-test-with-interfaces nil
    (should-not (kittymacs-agent--primary))
    (should-error (kittymacs-agent-start) :type 'user-error))
  (kittymacs-agents-test-with-interfaces '(agents agent-gptel)
    (cl-letf (((symbol-function 'locate-library)
               (lambda (name &rest _) (and (equal name "gptel-agent") "installed"))))
      (should (eq (kittymacs-agent--primary) 'gptel-agent)))))

(ert-deftest kittymacs-agents-primary-rebinds-shared-keys-and-preserves-other-maps ()
  (kittymacs-agents-test-with-interfaces '(agents agent-gptel claude-code-ide)
    (let ((kittymacs-agent-map (make-sparse-keymap))
          (ide-map (make-sparse-keymap)))
      (keymap-set ide-map "w" #'ignore)
      (keymap-set ide-map "d" #'ignore)
      (keymap-set ide-map "j" #'ignore)
      (keymap-set kittymacs-agent-map "w" ide-map)
      (keymap-set kittymacs-agent-map "c" #'ignore)
      (kittymacs-agent-set-primary 'agent-shell)
      (should (keymap-lookup kittymacs-agent-map "t"))
      (kittymacs-agent-set-primary 'gptel-agent)
      (should-not (keymap-lookup kittymacs-agent-map "t"))
      (should (keymap-lookup kittymacs-agent-map "p"))
      (should (eq (keymap-lookup kittymacs-agent-map "c") #'ignore))
      (should (eq (keymap-lookup kittymacs-agent-map "w") ide-map))
      (dolist (key '("w" "d" "j"))
        (should (eq (keymap-lookup ide-map key) #'ignore))))))

(ert-deftest kittymacs-agents-shared-start-dispatches-to-each-selected-interface ()
  (kittymacs-agents-test-with-interfaces '(agents agent-gptel claude-code-ide)
    (dolist (row '((agent-shell . agent-shell)
                   (gptel-agent . kittymacs-agent-gptel-start-or-switch)
                   (claude-code-ide . kittymacs-agent-claude-code-ide-start-or-switch)))
      (let ((kittymacs-agent-primary-interface (car row)) called)
        (cl-letf (((symbol-function 'call-interactively)
                   (lambda (command &rest _) (setq called command))))
          (kittymacs-agent-start))
        (should (eq called (cdr row)))))))
